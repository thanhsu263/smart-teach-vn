# Copy to .env and change the values. Never commit .env.
# The backend reads ../.env automatically when run from backend/ (spring.config.import).

# PostgreSQL container (user and database are both "smartteach")
POSTGRES_PASSWORD=change-me-db-password
DB_PORT=5432

# Backend
DB_USERNAME=smartteach
DB_PASSWORD=change-me-db-password
SERVER_PORT=8080
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
# Frontend origin(s) allowed by CORS, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Refresh cookie: secure=true and SameSite=None when frontend and backend are on different HTTPS domains
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Mail (password reset). Locally the backend sends SMTP to Mailpit (docker compose, inbox on :8025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@smartteach.local
# Production only: Render's free plan blocks SMTP, so set a Brevo API key to send over HTTPS instead.
BREVO_API_KEY=
# Frontend address used in email links
APP_FRONTEND_URL=http://localhost:5173

# Operations
# Password of the "prometheus" user for /actuator/prometheus (HTTP Basic). Empty = endpoint closed.
METRICS_PASSWORD=change-me-metrics-password
# Rate limits on login/register/refresh/forgot-password and the public student/live endpoints
RATE_LIMIT_ENABLED=true

# Demo data (only with SPRING_PROFILES_ACTIVE=demo, e.g. `docker compose --profile app up`).
# The demo teacher's classes, quizzes and assignments are recreated on every start.
DEMO_EMAIL=demo@smartteach.vn
DEMO_PASSWORD=change-me-demo-password
